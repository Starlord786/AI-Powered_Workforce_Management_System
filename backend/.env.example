# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is git-ignored - never commit it.

DB_PASSWORD=your-postgres-password
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Optional overrides
# DB_URL=jdbc:postgresql://localhost:5432/workforce_db
# DB_USERNAME=postgres
# AI_SERVICE_URL=http://localhost:8000

# First run only: create demo users. Leave a password blank to get a random one printed in the console.
# SEED_DEMO_USERS=true
# SEED_ADMIN_PASSWORD=
# SEED_HR_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=
